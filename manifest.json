{
  "manifest_version": 3,
  "name": "Cat GateKeeper",
  "version": "1.0.0",
  "description": "帮助用户定时休息的浏览器插件，保护眼睛健康",
  "permissions": [
    "storage",
    "alarms",
    "tabs",
    "activeTab"
  ],
  "action": {
    "default_popup": "popup/popup.html"
  },
  "background": {
    "service_worker": "background/background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "css": ["content/content.css"],
      "js": ["content/content.js"]
    }
  ],
  "icons": {
    "16": "assets/icon.svg",
    "48": "assets/icon.svg",
    "128": "assets/icon.svg"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/icon.svg"
      ],
      "matches": ["<all_urls>"]
    }
  ]
}